# CANARY SERVER (opt-in, for SSRF/XXE OOB detection)
# ═══════════════════════════════════════════════════════════════

class CanaryHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        _CANARY_LOG.append({"t": time.time(), "path": self.path,
                            "ua": self.headers.get("User-Agent",""),
                            "src": self.client_address[0]})
        self.send_response(200); self.end_headers()
        self.wfile.write(b"ok")
    def do_POST(self): self.do_GET()
    def log_message(self, *a): pass

_CANARY_LOG = []
_CANARY_THREAD = None

def start_canary():
    global _CANARY_THREAD
    srv = HTTPServer(("0.0.0.0", CANARY_PORT), CanaryHandler)
    _CANARY_THREAD = threading.Thread(target=srv.serve_forever, daemon=True)
    _CANARY_THREAD.start()
    print(f"[canary] listening on :{CANARY_PORT} path {CANARY_PATH}")

def canary_hits():
    return [h for h in _CANARY_LOG if h["path"].startswith(CANARY_PATH)]

def canary_url():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80)); ip = s.getsockname()[0]; s.close()
        return f"http://{ip}:{CANARY_PORT}{CANARY_PATH}"
    except Exception:
        return f"http://127.0.0.1:{CANARY_PORT}{CANARY_PATH}"

