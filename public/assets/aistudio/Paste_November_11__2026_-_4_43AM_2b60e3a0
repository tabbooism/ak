@dataclass
class Finding:
    id:        str
    cls:       str
    target:    str
    status:    str          # CONFIRMED / LIKELY / NOT_REPRODUCED / ERROR / INFO
    severity:  str          # CRITICAL / HIGH / MEDIUM / LOW / INFO
    confidence: str         # HIGH / MEDIUM / LOW
    cvss:      float
    evidence:  str
    request:   str = ""
    response:  str = ""
    remediation: str = ""
    compliance: list = field(default_factory=list)
    ts:        str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())

# ═══════════════════════════════════════════════════════════════
# HELPERS
# ═══════════════════════════════════════════════════════════════

def guard(url):
    host = urlparse(url).hostname or ""
    if host not in ALLOWED_HOSTS:
        raise SystemExit(f"REFUSING: {host} not in ALLOWED_HOSTS")

def sess(token_key="a"):
    s = requests.Session()
    s.headers.update({"User-Agent": UA, "Accept": "application/json",
                      "Origin": WEB, "Referer": WEB + "/"})
    t = TOKENS.get(token_key, "")
    if t: s.headers["Authorization"] = f"Bearer {t}"
    return s

def send(s, method, url, **kw):
    guard(url)
    if DRY_RUN: return None
    time.sleep(RATE_DELAY + random.uniform(0, 0.3))
    kw.setdefault("timeout", TIMEOUT)
    kw.setdefault("allow_redirects", False)
    try:
        return s.request(method, url, **kw)
    except requests.exceptions.RequestException as e:
        return _FakeResp(str(e))

class _FakeResp:
    def __init__(self, err): self.status_code = 0; self.text = ""; self.headers = {}; self.err = err

def snip(r, n=300):
    if r is None: return ""
    return (r.text or "")[:n].replace("\n", " ")

def F(**kw):
    """Finding factory with sensible defaults."""
    kw.setdefault("confidence", "MEDIUM")
    kw.setdefault("cvss", 0.0)
    kw.setdefault("remediation", "")
    kw.setdefault("compliance", [])
    return Finding(**kw)

