# SUITE 13 — TLS
# ═══════════════════════════════════════════════════════════════

def suite_tls():
    out = []
    for host in ("runehall.com", "api.runehall.com", "p2.runehall.com"):
        try:
            ctx = ssl.create_default_context()
            with socket.create_connection((host, 443), timeout=TIMEOUT) as sock:
                with ctx.wrap_socket(sock, server_hostname=host) as ss:
                    ver = ss.version()
                    cipher = ss.cipher()
                    cert = ss.getpeercert()
                    if ver and ver.startswith("TLSv1.0") or ver.startswith("TLSv1.1"):
                        out.append(F(id=f"TLS-weak-{host}", cls="tls", target=host,
                                     status="CONFIRMED", severity="HIGH", confidence="HIGH",
                                     cvss=6.5, evidence=f"Negotiated {ver}",
                                     remediation="Require TLSv1.2+; disable TLSv1.0/1.1",
                                     compliance=["NIST SC-8","ASVS 9.1.2"]))
                    else:
                        out.append(F(id=f"TLS-ok-{host}", cls="tls", target=host,
                                     status="NOT_REPRODUCED", severity="INFO",
                                     confidence="HIGH",
                                     evidence=f"TLS {ver}, cipher {cipher[0] if cipher else '?'}"))
        except ssl.SSLError as e:
            out.append(F(id=f"TLS-err-{host}", cls="tls", target=host, status="ERROR",
                         severity="INFO", evidence=f"SSL error: {e}"))
        except Exception as e:
            out.append(F(id=f"TLS-err-{host}", cls="tls", target=host, status="ERROR",
                         severity="INFO", evidence=str(e)[:120]))
    return out

