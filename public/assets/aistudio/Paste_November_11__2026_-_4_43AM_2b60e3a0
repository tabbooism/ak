def suite_auth():
    out = []
    # No-token request — should be 401, not 200
    s = requests.Session()
    s.headers.update({"User-Agent": UA, "Accept": "application/json", "Origin": WEB})
    for ep in (EP["two_factor"], EP["notifications"], EP["races"]):
        r = send(s, "GET", ep)
        if r is None: continue
        if r.status_code == 200:
            out.append(F(id=f"AUTH-noauth-{ep.split('/')[-1]}", cls="auth", target=ep,
                         status="CONFIRMED", severity="HIGH", confidence="HIGH", cvss=7.5,
                         evidence=f"HTTP 200 without Authorization header (body_len={len(r.text)})",
                         remediation="Require authentication on this endpoint",
                         compliance=["OWASP A07","CWE-306","ASVS 4.1.1"]))
        else:
            out.append(F(id=f"AUTH-noauth-{ep.split('/')[-1]}", cls="auth", target=ep,
                         status="NOT_REPRODUCED", severity="INFO", confidence="HIGH",
                         evidence=f"Correctly rejected with HTTP {r.status_code}"))

    # Invalid bearer
    s2 = requests.Session()
    s2.headers.update({"User-Agent": UA, "Accept": "application/json",
                       "Authorization": "Bearer INVALID_TOKEN_TEST", "Origin": WEB})
    r = send(s2, "GET", EP["two_factor"])
    if r is not None:
        status = "NOT_REPRODUCED" if r.status_code in (401, 403) else "CONFIRMED"
        sev = "HIGH" if status == "CONFIRMED" else "INFO"
        out.append(F(id="AUTH-invalid-token", cls="auth", target=EP["two_factor"],
                     status=status, severity=sev, confidence="HIGH",
                     cvss=7.5 if sev=="HIGH" else 0.0,
                     evidence=f"Invalid bearer returned HTTP {r.status_code}",
                     remediation="Reject unknown bearers with 401/403",
                     compliance=["OWASP A07"]))
    return out

