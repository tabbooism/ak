# REPORTING
# ═══════════════════════════════════════════════════════════════

SEV_ORDER = {"CRITICAL":0,"HIGH":1,"MEDIUM":2,"LOW":3,"INFO":4}

def report_markdown(findings, path):
    conf = sum(1 for f in findings if f.status in ("CONFIRMED","LIKELY"))
    by_sev = {s: sum(1 for f in findings if f.severity == s and f.status in ("CONFIRMED","LIKELY"))
              for s in ("CRITICAL","HIGH","MEDIUM","LOW","INFO")}
    lines = [
        f"# RuneHall — Adversarial Validation Report",
        f"",
        f"**Generated:** {datetime.now(timezone.utc).isoformat()}  ",
        f"**Scope:** runehall.com, api.runehall.com, p2.runehall.com  ",
        f"**Method:** Non-destructive adversarial validation (owner self-test)  ",
        f"**Suites run:** {conf} confirmed findings across {len(set(f.cls for f in findings))} categories  ",
        f"",
        f"## Executive Summary",
        f"",
        f"| Severity | Confirmed |",
        f"|---|---|",
    ]
    for s in ("CRITICAL","HIGH","MEDIUM","LOW"):
        lines.append(f"| {s} | {by_sev[s]} |")
    lines += ["", "## Findings", ""]

    for sev in ("CRITICAL","HIGH","MEDIUM","LOW"):
        group = [f for f in findings if f.severity == sev and f.status in ("CONFIRMED","LIKELY")]
        if not group: continue
        lines.append(f"### {sev}")
        for f in group:
            lines += [
                f"",
                f"#### `{f.id}` — {f.cls}",
                f"",
                f"- **Target:** `{f.target}`",
                f"- **Status:** {f.status}  |  **Confidence:** {f.confidence}  |  **CVSS:** {f.cvss}",
                f"- **Evidence:** {f.evidence}",
            ]
            if f.request:  lines.append(f"- **Request:** `{f.request[:200]}`")
            if f.response: lines.append(f"- **Response:** `{f.response[:200]}`")
            if f.remediation:
                lines.append(f"- **Remediation:** {f.remediation}")
            if f.compliance:
                lines.append(f"- **Compliance:** {', '.join(f.compliance)}")
        lines.append("")
    with open(path, "w") as fh:
        fh.write("\n".join(lines))

def report_json(findings, path):
    with open(path, "w") as fh:
        json.dump({"ts": datetime.now(timezone.utc).isoformat(),
                   "dry_run": DRY_RUN,
                   "findings": [asdict(f) for f in findings]}, fh, indent=2)

def report_csv(findings, path):
    if not findings: return
    with open(path, "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=list(asdict(findings[0]).keys()))
        w.writeheader()
        for f in findings: w.writerow(asdict(f))

# ═══════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--only", default=DEFAULT_SUITES)
    ap.add_argument("--canary", action="store_true", help="Start canary HTTP server for SSRF/XXE")
    ap.add_argument("--out", default="validation_v2")
    args = ap.parse_args()

    global DRY_RUN
    if args.dry_run: DRY_RUN = True
    if args.canary:
        start_canary()

    if not TOKENS.get("a"):
        print("WARNING: no token A — authed suites will report ERROR")
    if not TOKENS.get("b"):
        print("WARNING: no token B — cross-account IDOR checks skipped")

    suites = [s.strip() for s in args.only.split(",") if s.strip() in SUITES]
    if not suites: sys.exit(f"Choose from: {','.join(SUITES.keys())}")

    print(f"\nRunning {len(suites)} suites against runehall.com (dry_run={DRY_RUN})\n")

    all_findings = []
    for name in suites:
        print(f"[{name:12}]", end=" ... ", flush=True)
        try:
            results = SUITES[name]()
        except SystemExit: raise
        except Exception as e:
            print(f"ERROR {type(e).__name__}: {e}")
            results = [F(id=f"ERR-{name}", cls=name, target="-", status="ERROR",
                         severity="INFO", evidence=str(e)[:200])]
            all_findings += results; continue
        all_findings += results
        c = {}
        for f in results: c[f.status] = c.get(f.status, 0) + 1
        print(" ".join(f"{k}={v}" for k,v in sorted(c.items())))

    all_findings.sort(key=lambda f: (SEV_ORDER.get(f.severity, 99), f.status, f.id))

    report_json(all_findings, f"{args.out}.json")
    report_csv(all_findings, f"{args.out}.csv")
    report_markdown(all_findings, f"{args.out}.md")

    conf = [f for f in all_findings if f.status in ("CONFIRMED","LIKELY")]
    print(f"\n─── SUMMARY ───")
    print(f"Confirmed: {len(conf)} / {len(all_findings)} findings")
    for sev in ("CRITICAL","HIGH","MEDIUM","LOW"):
        n = sum(1 for f in conf if f.severity == sev)
        if n: print(f"  {sev:8} {n}")
    print(f"\nWrote: {args.out}.json  {args.out}.csv  {args.out}.md")

if __name__ == "__main__":
    main()