def suite_errors():
    out = []
    if not TOKENS.get("a"): return out
    s = sess("a")
    malformed = [
        (EP["two_factor"], b"{not-json", "application/json"),
        (EP["races"],      b"[", "application/json"),
        (EP["bonus"],      b"\x00\x01\x02", "application/json"),
    ]
    for url, body, ct in malformed:
        guard(url)
