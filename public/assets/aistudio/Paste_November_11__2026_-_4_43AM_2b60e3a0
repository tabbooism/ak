            out.append(F(id=f"ERR-leak-{url.split('/')[-1]}", cls="errors", target=url,
                         status="CONFIRMED", severity="MEDIUM", confidence="HIGH", cvss=5.3,
                         evidence="Malformed request reveals stack trace / internal path",
                         response=snip(r, 300),
                         remediation="Disable debug mode in production; return generic error "
                                     "with correlation ID; log full detail server-side",
                         compliance=["OWASP A05","CWE-209","ASVS 7.4.1"]))
    return out

