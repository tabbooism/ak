# SUITE 12 — CORS
# ═══════════════════════════════════════════════════════════════

def suite_cors():
    out = []
    s = requests.Session()
    s.headers.update({"User-Agent": UA})
    for origin in ("https://evil.example", "https://runehall.com",
                   "null", "https://runehall.com.evil.example"):
        for method in ("GET", "POST"):
            try:
                r = s.options(EP["notifications"], timeout=TIMEOUT,
                              headers={"Origin": origin,
                                       "Access-Control-Request-Method": method,
                                       "Access-Control-Request-Headers": "authorization"})
            except Exception:
                continue
            acao = r.headers.get("access-control-allow-origin", "")
            acac = r.headers.get("access-control-allow-credentials", "")
            # Bad: wildcard ACAO with credentials; or evil.example echoed back
            bad = (acao == "*" and acac == "true") or \
                  ("evil.example" in acao) or \
                  (acao == "null")
            if bad:
                out.append(F(id=f"CORS-{origin}-{method}", cls="cors", target=EP["notifications"],
                             status="CONFIRMED", severity="HIGH", confidence="HIGH", cvss=7.4,
                             evidence=f"Origin={origin} ACAO={acao!r} ACAC={acac!r}",
                             remediation="Allowlist specific origins; never combine ACAO=* "
                                         "with credentials=true",
                             compliance=["OWASP A05","CWE-942","ASVS 14.5.3"]))
    # If nothing bad, record a positive
    if not any(f.cls=="cors" for f in out):
        out.append(F(id="CORS-matrix", cls="cors", target=EP["notifications"],
                     status="NOT_REPRODUCED", severity="INFO", confidence="HIGH",
                     evidence="CORS preflight correctly scoped to runehall.com for all tested origins"))
    return out

