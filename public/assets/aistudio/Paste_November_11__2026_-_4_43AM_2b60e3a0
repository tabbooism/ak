ID_SAMPLES = [1, 2, 3, 100, 507732, 9999, 0, -1]

def suite_idor():
    out = []
    if not TOKENS.get("a"):
        return [F(id="IDOR", cls="idor", target="-", status="ERROR", severity="INFO",
                  evidence="No token A — set RUNEHALL_TOKEN_A")]
    sa = sess("a"); sb = sess("b") if TOKENS.get("b") else None

    def probe(url, tag, sev_if_200="HIGH", expect_own_id=None):
        r = send(sa, "GET", url)
        if r is None: return
        body_len = len(r.text or "")
        is_idor = (r.status_code == 200 and body_len > 50
                   and (expect_own_id is None or expect_own_id not in str(url)))
        if is_idor:
            out.append(F(id=f"IDOR-{tag}", cls="idor", target=url, status="LIKELY",
                         severity=sev_if_200, confidence="MEDIUM",
                         cvss=6.5 if sev_if_200=="HIGH" else 4.3,
                         evidence=f"HTTP 200 body_len={body_len} (unauthorized object?)",
                         response=snip(r, 200),
                         remediation="Enforce object-level authorization on every read",
                         compliance=["OWASP A01","ASVS 4.1.1","CWE-639","NIST AC-3"]))

    # 3a. ?user_id=N
    for uid in ID_SAMPLES:
        probe(f"{EP['two_factor']}?user_id={uid}", f"twofactor-q-{uid}")

    # 3b. /api/user/{id}/two-factor
    for uid in ID_SAMPLES:
        probe(EP["two_factor_uid"].format(uid=uid), f"twofactor-p-{uid}")

    # 3c. /api/promos/races/{id}
    for uid in [196, 1, 2, 100, 9999]:
        probe(EP["races_id"].format(id=uid), f"races-{uid}", sev_if_200="MEDIUM")

    # 3d. Broadcast channel auth — try known channels with A, then B
    for ch in ["private-user.507732", "private-user.1",
               "private-conversation.196", "presence-chat"]:
        url = EP["broadcast_auth"]
        r = send(sa, "POST", url, json={"channel_name": ch, "socket_id": "1.1"})
        if r is None: continue
        if r.status_code in (200, 202):
            out.append(F(id=f"IDOR-broadcast-{ch}", cls="idor", target=url,
                         status="LIKELY", severity="MEDIUM", confidence="LOW", cvss=4.3,
                         evidence=f"channel {ch} authorized for token A (HTTP {r.status_code})",
                         remediation="Verify broadcast channel authorization binds to token subject",
                         compliance=["OWASP A01","CWE-639"]))

    # 3e. Cross-account diff
    if sb:
        for tag, url in [("two_factor", EP["two_factor"]),
                          ("notifications", EP["notifications"])]:
            ra = send(sa, "GET", url)
            rb = send(sb, "GET", url)
            if ra is None or rb is None: continue
            if ra.status_code == 200 and rb.status_code == 200 and ra.text != rb.text:
                out.append(F(id=f"IDOR-crossdiff-{tag}", cls="idor", target=url,
                             status="INFO", severity="INFO", confidence="HIGH",
                             evidence="A/B responses differ as expected (different users)",
                             remediation="No action needed — validates per-user scoping",
                             compliance=[]))
    return out

# ═══════════════════════════════════════════════════════════════
# SUITE 4 — RACE (budget-capped, non-destructive)
# ═══════════════════════════════════════════════════════════════

def suite_race():
    out = []
    if not TOKENS.get("a"):
        return [F(id="RACE", cls="race", target="-", status="ERROR", severity="INFO",
                  evidence="No token A")]

    def burst(url, payload, tag):
        def one(_):
            s = sess("a")
            try:
                r = s.post(url, json=payload, timeout=TIMEOUT, allow_redirects=False,
                           headers={"Accept": "application/json"})
                return r.status_code
            except Exception:
                return "ERR"
        # baseline
        base = one(0)
        statuses = [base]
        with cf.ThreadPoolExecutor(max_workers=RACE_COUNT) as ex:
            statuses += list(ex.map(one, range(RACE_COUNT)))
        ok200 = statuses.count(200)
        if ok200 > 1:
            return F(id=f"RACE-{tag}", cls="race", target=url, status="LIKELY",
                     severity="HIGH", confidence="MEDIUM", cvss=6.5,
                     evidence=f"Multiple 200s in concurrent burst: {statuses} "
                              f"(server may not serialize balance mutations)",
                     remediation="Add database-level idempotency key or serializable transaction",
                     compliance=["OWASP A04","CWE-362","NIST SI-10"])
        return F(id=f"RACE-{tag}", cls="race", target=url, status="NOT_REPRODUCED",
                 severity="INFO", confidence="HIGH",
                 evidence=f"Burst statuses: {statuses} — no duplicate 200 (or body rejected)")

    out.append(burst(EP["bonus"],         {}, "bonus"))
    out.append(burst(EP["poker_exchange"],{}, "exchange"))
    out.append(F(id="RACE-note", cls="race", target="-", status="INFO", severity="INFO",
                 evidence="Empty-body burst measures server concurrency only; to test the "
                          "actual race, replace {} with the real body captured from a live click"))
    return out

