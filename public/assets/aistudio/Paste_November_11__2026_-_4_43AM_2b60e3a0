MASS_FIELDS = {"enabled": True, "is_admin": True, "role": "admin",
               "verified": True, "level": 999, "balance": 1000000}

def suite_mass():
    out = []
    if not TOKENS.get("a"):
        return [F(id="MASS", cls="mass", target="-", status="ERROR", severity="INFO",
                  evidence="No token A")]
    s = sess("a")
    for url, base_payload in MASS_ASSIGN:
        payload = {**base_payload, **MASS_FIELDS}
        r = send(s, "PATCH", url, json=payload)
        if r is None: continue
        body = r.text or ""
        # If server echoes any admin field back as accepted → mass assignment
        echoed = [k for k in MASS_FIELDS if f'"{k}":true' in body
                                    or f'"{k}":"admin"' in body
                                    or f'"{k}":999' in body]
        if echoed and r.status_code in (200, 201):
            out.append(F(id=f"MASS-{url.split('/')[-1]}", cls="mass", target=url,
                         status="LIKELY", severity="HIGH", confidence="MEDIUM", cvss=8.1,
                         evidence=f"Response echoes accepted fields: {echoed} (HTTP {r.status_code})",
                         remediation="Use explicit allowlist of assignable attributes; never bind "
                                     "request body directly to model. Laravel: use $fillable/$guarded",
                         compliance=["OWASP A01","CWE-915","ASVS 5.3.3"]))
        else:
            out.append(F(id=f"MASS-{url.split('/')[-1]}", cls="mass", target=url,
                         status="NOT_REPRODUCED", severity="INFO", confidence="MEDIUM",
                         evidence=f"No admin fields echoed (HTTP {r.status_code})"))
    return out

