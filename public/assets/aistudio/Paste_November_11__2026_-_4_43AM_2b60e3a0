# SUITE 8 — RATE LIMIT
# ═══════════════════════════════════════════════════════════════

def suite_ratelimit():
    out = []
    if not TOKENS.get("a"):
        return [F(id="RATE", cls="ratelimit", target="-", status="ERROR",
                  severity="INFO", evidence="No token A")]
    url = EP["notifications"]
    s = sess("a")
    statuses = []
    for _ in range(RATE_BURST):
        r = send(s, "GET", url)
        if r is None: break
        statuses.append(r.status_code)
    n429 = statuses.count(429)
    hdr_limit = None
    try:
        r0 = send(sess("a"), "GET", url)
        if r0 is not None:
            hdr_limit = r0.headers.get("x-ratelimit-limit")
    except Exception: pass

    if n429 == 0:
        out.append(F(id="RATE-enforced", cls="ratelimit", target=url, status="LIKELY",
                     severity="MEDIUM", confidence="MEDIUM", cvss=4.3,
                     evidence=f"{RATE_BURST} requests sent, 0× 429. "
                              f"Advertised limit={hdr_limit}. Consider tightening per-route limits.",
                     remediation="Enforce rate limits at edge (Cloudflare) and origin. "
                                 "Return 429 with Retry-After.",
                     compliance=["OWASP A04","CWE-770","NIST SC-5"]))
    else:
        out.append(F(id="RATE-enforced", cls="ratelimit", target=url, status="NOT_REPRODUCED",
                     severity="INFO", confidence="HIGH",
                     evidence=f"{n429}/{len(statuses)} returned 429 — rate limit active"))
    return out

