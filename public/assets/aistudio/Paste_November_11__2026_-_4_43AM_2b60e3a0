    global CMDI_MARKER, CMDI_PROBES
    if not INJECTION_TARGETS:
        return [F(id="INJ", cls="injection", target="-", status="INFO", severity="INFO",
                  evidence="No injection targets configured — populate INJECTION_TARGETS from "
                           "THOR evidence export (endpoint+param) to enable SSTI/CMDi/LFI/SSRF/XXE tests")]
    CMDI_MARKER = "SAFEVAL_" + str(int(time.time()))
    CMDI_PROBES = [f"; echo {CMDI_MARKER}", f"| echo {CMDI_MARKER}",
                   f"$(echo {CMDI_MARKER})", f"& echo {CMDI_MARKER}"]

    out = []
    s = sess("a")

    for t in INJECTION_TARGETS:
        cls = t["class"]; url = t["url"]; param = t["param"]; method = t.get("method","GET")

        def fire(value, tag):
            kw = {"params" if method=="GET" else "json": {param: value}}
            r = send(s, method, url, **kw)
            if r is None: return None, ""
            body = r.text or ""
            return r, body

        if cls == "ssti":
            for payload, expect in SSTI_PROBES:
                r, body = fire(payload, "ssti")
                if expect in body:
                    out.append(F(id=t["id"], cls="ssti", target=url, status="CONFIRMED",
                                 severity="HIGH", confidence="HIGH", cvss=8.1,
                                 evidence=f"{payload!r} → {expect!r} in response",
                                 request=f"{param}={payload}", response=snip(r),
                                 remediation="Use logic-less templates or sandboxed engine; "
                                             "context-aware escaping; never render user input as template",
                                 compliance=["OWASP A03","CWE-1336","ASVS 5.3.4","NIST SI-10"]))
                    break
            else:
                out.append(F(id=t["id"], cls="ssti", target=url, status="NOT_REPRODUCED",
                             severity="INFO", confidence="MEDIUM",
                             evidence="No arithmetic evaluation with benign probes"))

        elif cls == "cmdi":
            for payload in CMDI_PROBES:
                r, body = fire(payload, "cmdi")
                if CMDI_MARKER in body:
                    out.append(F(id=t["id"], cls="cmdi", target=url, status="CONFIRMED",
                                 severity="CRITICAL", confidence="HIGH", cvss=9.8,
                                 evidence=f"Benign marker echoed via {payload!r}",
                                 request=f"{param}={payload}", response=snip(r),
                                 remediation="Replace shell interpolation with argument-vector "
                                             "exec (subprocess.run(cmd, shell=False)); allowlist "
                                             "commands; drop privileges; isolate execution",
                                 compliance=["OWASP A03","CWE-78","ASVS 5.3.8","NIST SI-10"]))
                    break
            else:
                out.append(F(id=t["id"], cls="cmdi", target=url, status="NOT_REPRODUCED",
                             severity="INFO", confidence="MEDIUM",
                             evidence="Benign echo marker not returned"))

        elif cls == "lfi":
            for trav in LFI_TRAVS:
                r, body = fire(trav, "lfi")
                if CANARY_STRING in body:
                    out.append(F(id=t["id"], cls="lfi", target=url, status="CONFIRMED",
                                 severity="HIGH", confidence="HIGH", cvss=7.5,
                                 evidence=f"Canary read via {trav!r}",
                                 request=f"{param}={trav}", response=snip(r),
                                 remediation="Canonicalize paths; allowlist base dir; reject '..'; "
                                             "open with O_NOFOLLOW; run in chroot",
                                 compliance=["OWASP A01","CWE-22","ASVS 12.3.1"]))
                    break
