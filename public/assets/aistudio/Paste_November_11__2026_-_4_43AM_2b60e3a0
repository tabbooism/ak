            else:
                out.append(F(id=t["id"], cls="ssrf", target=url, status="NOT_REPRODUCED",
                             severity="INFO", confidence="MEDIUM",
                             evidence=f"No canary hit for {cu} (egress may be blocked)"))

        elif cls == "xxe":
            payload = (f'<?xml version="1.0"?><!DOCTYPE x [<!ENTITY xxe SYSTEM "{canary_url()}">]>'
